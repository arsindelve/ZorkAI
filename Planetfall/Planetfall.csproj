<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ChatLambda\ChatLambda.csproj" />
        <ProjectReference Include="..\GameEngine\GameEngine.csproj"/>
        <ProjectReference Include="..\Model\Model.csproj"/>
        <ProjectReference Include="..\StellarPatrol\StellarPatrol.csproj"/>
        <!-- AI/ builds its own chat clients against the shared endpoint settings, so this is a direct
             dependency rather than one inherited through ChatLambda. -->
        <ProjectReference Include="..\ZorkAI.OpenAI\ZorkAI.OpenAI.csproj"/>
        <ProjectReference Include="..\ZorkOne\ZorkOne.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    </ItemGroup>

    <!-- The hint oracle's knowledge: the game bible and the first-seen state baseline
         (Planetfall.Tests/Hints/Oracle/GameBibleGenerator writes both; review, then check in). -->
    <ItemGroup>
        <EmbeddedResource Include="Hints/Oracle/planetfall-bible.md" />
        <EmbeddedResource Include="Hints/Oracle/planetfall-initial-state.json" />
    </ItemGroup>

</Project>
